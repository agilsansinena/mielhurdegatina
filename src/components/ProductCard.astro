---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AddToCartButton from './AddToCartButton.astro';

interface Props {
  id: string;
  href: string;
  name: string;
  price: number;
  description: string;
  image: ImageMetadata;
  badge?: string;
  weight?: string;
}

const { id, href, name, price, description, image, badge, weight } = Astro.props;
---

<div class="product-card group relative bg-white rounded-2xl overflow-hidden border border-stone-100 hover:border-brand-200/60 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_60px_-15px_rgba(202,138,4,0.15)]">

  {badge && (
    <div class="absolute top-4 left-4 z-20">
      <span class={`
        inline-flex items-center gap-1 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-sm
        ${badge === 'Best Seller'
          ? 'bg-gradient-to-r from-brand-500 to-brand-400 text-white'
          : 'bg-stone-900 text-white'}
      `}>
        {badge === 'Best Seller' && (
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        )}
        {badge}
      </span>
    </div>
  )}

  {weight && (
    <div class="absolute top-4 right-4 z-20">
      <span class="inline-block px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/90 text-stone-600 border border-stone-200 backdrop-blur-sm shadow-sm">
        {weight}
      </span>
    </div>
  )}

  <!-- Image area with clean neutral background -->
  <div class="relative aspect-square overflow-hidden bg-gradient-to-b from-stone-50 to-white flex items-center justify-center p-8">
    <!-- Decorative circle -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[70%] h-[70%] rounded-full bg-stone-100/50 blur-2xl group-hover:scale-110 transition-transform duration-700"></div>
    </div>

    <a href={href} tabindex="-1" aria-hidden="true" class="absolute inset-0 z-20" aria-label={`Ver ficha de ${name}`}></a>
    <Image
      src={image}
      alt={`${name} - miel de bosque cruda de Las Hurdes`}
      class="relative z-10 w-full h-full object-contain drop-shadow-lg transition-all duration-700 group-hover:scale-110 group-hover:drop-shadow-2xl"
      width={500}
      densities={[1.5, 2]}
    />
  </div>

  <!-- Content -->
  <div class="p-5 space-y-3 relative z-20 bg-white">
    <!-- Separator line with gradient -->
    <div class="absolute top-0 left-5 right-5 h-px bg-gradient-to-r from-transparent via-brand-200/60 to-transparent"></div>

    <div class="space-y-1.5">
      <h3 class="text-lg font-display text-stone-900 font-semibold group-hover:text-brand-700 transition-colors duration-300">
        <a href={href} class="hover:underline decoration-brand-300 underline-offset-4">{name}</a>
      </h3>
      <div class="flex items-baseline gap-1.5">
        <span class="text-2xl font-bold text-brand-600 font-display tracking-tight">
          {price.toFixed(2)}€
        </span>
        <span class="text-xs text-stone-400 font-medium">
          IVA incluido
        </span>
      </div>
    </div>

    <p class="text-stone-500 text-sm leading-relaxed line-clamp-2">
      {description}
    </p>

    <div class="pt-1">
      <AddToCartButton
        id={id}
        name={name}
        price={price}
        image={image}
      />
    </div>
  </div>
</div>
