---
interface Props {
  id: string;
  name: string;
  price: number;
  description: string;
  image: ImageMetadata;
}

const { id, name, price, description, image } = Astro.props;
import { ShoppingBag } from 'lucide-astro';
import { Image } from 'astro:assets';
---

<div class="product-card group relative flex flex-col overflow-hidden rounded-2xl bg-white border border-stone-100 shadow-md transition-all hover:shadow-xl">
  <div class="aspect-square relative bg-stone-100">
      <Image 
        src={image} 
        alt={name}
        class="h-full w-full object-cover transition-transform duration-500 "
        width={400}
        densities={[1.5, 2]}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>

  <div class="p-6 flex flex-col flex-grow">
    <div class="mb-4">
        <h3 class="text-xl font-bold text-stone-800 font-display mb-2">{name}</h3>
        <p class="text-stone-600 text-sm leading-relaxed line-clamp-2" title={description}>
          {description}
        </p>
    </div>
    
    <div class="mt-auto flex items-center justify-between gap-4">
        <span class="text-2xl font-bold text-amber-600">{price.toFixed(2)}€</span>
        <button
            class="add-to-cart-btn px-4 py-2 rounded-full bg-amber-500 hover:bg-amber-400 text-white font-semibold text-sm transition-all transform hover:scale-105 active:scale-95 flex items-center gap-2 shadow-amber-500/20 shadow-lg"
            data-id={id}
            data-name={name}
            data-price={price}
            data-image={image.src}
        >
            <ShoppingBag class="w-4.5 h-4.5" />
            Añadir
        </button>
    </div>
  </div>
</div>

<script>
  import { addCartItem } from '../stores/cartStore';

  const buttons = document.querySelectorAll('.add-to-cart-btn');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const product = {
        id: btn.getAttribute('data-id'),
        name: btn.getAttribute('data-name'),
        price: Number(btn.getAttribute('data-price')),
        image: btn.getAttribute('data-image')
      };
      addCartItem(product);
      
      // Simple feedback animation
      const originalText = btn.innerHTML;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg> Añadido`;
      btn.classList.add('bg-green-500', 'text-white');
      btn.classList.remove('bg-amber-500', 'text-black');
      
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('bg-green-500', 'text-white');
        btn.classList.add('bg-amber-500', 'text-black');
      }, 2000);
    });
  });
</script>
