---
interface Props {
  id: string;
  name: string;
  price: number;
  description: string;
  image: ImageMetadata;
  badge?: string;
}

const { id, name, price, description, image, badge } = Astro.props;
import { ShoppingBag } from 'lucide-astro';
import { Image } from 'astro:assets';
---

<div class="product-card group relative bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
  
  {badge && (
    <div class="absolute top-4 left-4 z-20">
      <span class={`
        inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest
        ${badge === 'Best Seller' ? 'bg-brand-300 text-stone-900 border border-brand-400' : 'bg-stone-900 text-white'}
      `}>
        {badge}
      </span>
    </div>
  )}

  <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-stone-50 to-white px-4 pt-4 pb-0 flex items-center justify-center">
      <Image 
        src={image} 
        alt={name}
        class="w-full h-full object-contain filter drop-shadow-md transition-transform duration-700 group-hover:scale-105 group-hover:drop-shadow-xl"
        width={500}
        densities={[1.5, 2]}
      />
  </div>

  <div class="p-4 text-center space-y-2 relative z-20 bg-white">
    <div class="space-y-1">
        <h3 class="text-lg font-display text-stone-900 font-medium group-hover:text-brand-600 transition-colors duration-300">
          {name}
        </h3>
        <p class="text-lg font-bold text-brand-600 font-display">
          {price.toFixed(2)}€
        </p>
    </div>
    
    <p class="text-stone-500 text-xs leading-relaxed line-clamp-2 px-1">
      {description}
    </p>

    <div class="pt-2 w-full">
         <button
            class="add-to-cart-btn w-full py-2 rounded-full bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs tracking-widest uppercase transition-all duration-300 flex items-center justify-center gap-2 shadow-sm hover:shadow-xl hover:-translate-y-0.5 border border-stone-800 hover:border-brand-400 group-btn"
            data-id={id}
            data-name={name}
            data-price={price}
            data-image={image.src}
        >
            <ShoppingBag class="w-3.5 h-3.5 transition-transform group-btn-hover:scale-110" />
            <span>Añadir al Carrito</span>
        </button>
    </div>
  </div>
</div>

<script>
  import { addCartItem } from '../stores/cartStore';

  const buttons = document.querySelectorAll('.add-to-cart-btn');
  buttons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      // Prevent the click from propagating if necessary, though on a button it's usually fine
      // e.stopPropagation(); 
      
      const product = {
        id: btn.getAttribute('data-id'),
        name: btn.getAttribute('data-name'),
        price: Number(btn.getAttribute('data-price')),
        image: btn.getAttribute('data-image')
      };
      addCartItem(product);
      
      const originalHtml = btn.innerHTML;
      const originalClasses = [...btn.classList];

      // Feedback state
      const feedbackClasses = ['bg-green-600', 'text-white', 'hover:bg-green-700', 'hover:text-white', '!translate-y-0']; // !translate-y-0 ensures it stays visible if we were to change logic
      
      btn.classList.remove('bg-stone-900', 'hover:bg-brand-400', 'hover:text-stone-900', 'text-white');
      btn.classList.add(...feedbackClasses);
      
      btn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>
        <span>Añadido</span>
      `;
      
      setTimeout(() => {
        btn.innerHTML = originalHtml;
        btn.classList.remove(...feedbackClasses);
         btn.classList.add('bg-stone-900', 'hover:bg-brand-400', 'hover:text-stone-900', 'text-white');
      }, 2000);
    });
  });
</script>
