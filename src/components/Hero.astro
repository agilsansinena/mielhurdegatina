---
import { Image } from 'astro:assets';
import heroBg from '../assets/Torrecilla_de_los_Angeles.jpg';
---

<section id="inicio" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <Image 
      src={heroBg} 
      alt="Paisaje de Las Hurdes" 
      class="w-full h-full object-cover blur-[1px]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-brand-950/20 to-brand-950/40 mix-blend-multiply"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-6 text-center text-white space-y-8 animate-[slide-up_0.8s_ease-out]">
    <div class="space-y-4">
      <span class="inline-block py-1 px-3 border border-white/30 rounded-full text-xs font-semibold tracking-wider uppercase bg-white/10 backdrop-blur-sm">
        Artesanía Pura desde 1980
      </span>
      <h1 class="text-5xl md:text-7xl font-display font-medium leading-tight !text-brand-300">
        El Oro dulce de <br/>
        <span class="text-brand-300 italic">Las Hurdes</span>
      </h1>
      <p class="text-lg md:text-xl text-stone-100 max-w-2xl mx-auto font-light leading-relaxed">
        Descubre la auténtica miel cruda, cosechada con pasión en los bosques vírgenes de Extremadura. Sabor intenso, natural y saludable.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a 
        href="#productos" 
        class="min-w-[160px] bg-brand-300 hover:bg-brand-400 text-stone-900 px-8 py-3.5 rounded-full font-semibold transition-all shadow-[0_0_20px_rgba(234,179,8,0.3)] hover:shadow-[0_0_30px_rgba(234,179,8,0.5)] transform hover:-translate-y-1"
      >
        Ver Productos
      </a>
      <a 
        href="#historia" 
        class="min-w-[160px] bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white px-8 py-3.5 rounded-full font-semibold transition-all transform hover:-translate-y-1"
      >
        Nuestra Historia
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-70">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-white">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</section>
