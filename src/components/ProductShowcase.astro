---
import { Image } from 'astro:assets';
import miel2kg from '../assets/miel2kg.avif';
import miel1kg from '../assets/miel1kg.avif';
import miel500g from '../assets/miel500g.avif';

import ProductCard from './ProductCard.astro';

import { products as productData } from '../data/products';

const products = productData.map(p => {
  let image;
  if(p.id === 'miel-bosque-2kg') image = miel2kg;
  else if(p.id === 'miel-bosque-1kg') image = miel1kg;
  else image = miel500g;

  return { ...p, image };
});
---

<section id="productos" class="py-24 bg-gradient-to-b from-white via-brand-50/30 to-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12 space-y-4 animate-[slide-up_1s_ease-out]">
      <span class="inline-block py-1 px-3 border border-brand-200 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-50 text-brand-700">
        Nuestros Tesoros
      </span>
      <h2 class="text-4xl md:text-5xl font-display font-medium text-brand-950">
        Nuestra Miel
      </h2>
      <p class="text-stone-600 max-w-2xl mx-auto text-lg leading-relaxed">
        Cosechada directamente de nuestras colmenas en la Sierra de Gata. Sin procesar, sin calentar y llena de matices salvajes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12 animate-[slide-up_1.2s_ease-out]">
      {products.map(product => (
        <ProductCard
          id={product.id}
          name={product.title}
          price={product.price}
          description={product.description}
          image={product.image}
        />
      ))}
    </div>
  </div>
</section>
