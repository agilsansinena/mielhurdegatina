---
import { Image } from 'astro:assets';
import miel2kg from '../assets/miel2kg.avif';
import miel1kg from '../assets/miel1kg.avif';
import miel500g from '../assets/miel500g.avif';

import ProductCard from './ProductCard.astro';

import { products as productData } from '../data/products';

const products = productData.map(p => {
  let image;
  if(p.id === 'miel-bosque-2kg') image = miel2kg;
  else if(p.id === 'miel-bosque-1kg') image = miel1kg;
  else image = miel500g;

  return { ...p, image };
});
---

<section id="productos" class="py-24 bg-gradient-to-b from-white via-brand-50/30 to-white relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-20 left-0 w-72 h-72 bg-brand-100/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-20 right-0 w-96 h-96 bg-amber-100/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16 space-y-5 animate-[slide-up_1s_ease-out]">
      <span class="inline-flex items-center gap-2 py-1.5 px-4 border border-brand-200 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-50 text-brand-700">
        <svg class="w-3.5 h-3.5 text-brand-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        100% Natural · Sierra de Gata
      </span>
      <h2 class="text-4xl md:text-5xl font-display font-medium text-brand-950">
        Nuestra Miel
      </h2>
      <p class="text-stone-500 max-w-2xl mx-auto text-lg leading-relaxed">
        Cosechada directamente de nuestras colmenas en la Sierra de Gata. Sin procesar, sin calentar y llena de matices salvajes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 animate-[slide-up_1.2s_ease-out]">
      {products.map(product => (
        <ProductCard
          id={product.id}
          name={product.title}
          price={product.price}
          description={product.description}
          image={product.image}
          badge={product.badge}
          weight={product.weight}
        />
      ))}
    </div>

    <!-- Trust indicators -->
    <div class="mt-14 flex flex-wrap items-center justify-center gap-8 text-xs text-stone-400 animate-[slide-up_1.4s_ease-out]">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Pago 100% Seguro</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="m16 8 5 3-5 3V8z"/></svg>
        <span>Envío en 24-48h</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span>Envío Gratis +60€</span>
      </div>
    </div>
  </div>
</section>
