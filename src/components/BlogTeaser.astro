---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---

<section id="blog-destacado" class="py-24 bg-stone-50">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div class="space-y-3">
        <span class="text-brand-600 font-semibold tracking-widest uppercase text-sm">Del blog</span>
        <h2 class="text-4xl md:text-5xl font-display font-medium text-stone-900">
          Aprende sobre la miel
        </h2>
        <p class="text-stone-600 max-w-xl text-lg">
          Lo que hemos aprendido en cinco generaciones cuidando abejas: cómo se hace la miel y cómo
          reconocer una miel de verdad.
        </p>
      </div>
      <a
        href="/blog"
        class="hidden md:inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800 transition-colors shrink-0"
      >
        Ver todos los artículos
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="group bg-white rounded-2xl overflow-hidden border border-stone-100 hover:border-brand-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <a href={`/blog/${post.id}`} class="block">
            <img
              src={post.data.image}
              alt={`Portada del artículo: ${post.data.title}`}
              width="1200"
              height="630"
              loading="lazy"
              decoding="async"
              class="w-full aspect-[16/9] object-cover group-hover:scale-[1.03] transition-transform duration-500"
            />
          </a>
          <div class="p-6 space-y-3">
            <p class="text-xs uppercase tracking-widest text-brand-600 font-semibold">
              {formatDate(post.data.date)}{post.data.readingTime && ` · ${post.data.readingTime}`}
            </p>
            <h3 class="text-xl font-display font-semibold text-stone-900 leading-snug">
              <a href={`/blog/${post.id}`} class="hover:text-brand-700 transition-colors">
                {post.data.title}
              </a>
            </h3>
            <p class="text-stone-600 text-sm leading-relaxed line-clamp-3">{post.data.description}</p>
            <a href={`/blog/${post.id}`} class="inline-block text-brand-700 font-semibold text-sm hover:text-brand-800 pt-1">
              Leer artículo →
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 text-center md:hidden">
      <a href="/blog" class="inline-flex items-center gap-2 text-brand-700 font-semibold">
        Ver todos los artículos
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
