---
import { ChevronDown } from 'lucide-astro';
import { faqs } from '../data/faqs';
---

<section id="faq" class="py-24 bg-white">
  <div class="container mx-auto px-6 max-w-4xl">
    <div class="text-center mb-16 space-y-4">
      <span class="text-brand-600 font-semibold tracking-wider uppercase text-sm">¿Tienes dudas?</span>
      <h2 class="text-4xl font-display font-medium text-stone-900">
        Preguntas Frecuentes
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-xl border border-stone-200 overflow-hidden transition-all duration-300 hover:shadow-md open:shadow-lg open:border-brand-200">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none text-stone-800 font-medium text-lg hover:text-brand-700 transition-colors">
            <span>{faq.question}</span>
            <span class="transform group-open:rotate-180 transition-transform duration-300 text-brand-500">
              <ChevronDown class="w-6 h-6" />
            </span>
          </summary>
          <div class="px-6 pb-6 text-stone-600 leading-relaxed border-t border-transparent group-open:border-stone-100 pt-4 animate-fade-in">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>

  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
