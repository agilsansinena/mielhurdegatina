---
import { Star, Quote } from 'lucide-astro';

const testimonials = [
  {
    name: "María García",
    location: "Plasencia",
    text: "Increíble sabor. Se nota que es miel de verdad, nada que ver con la del supermercado. El envío llegó súper rápido y muy bien protegido.",
    rating: 5
  },
  {
    name: "Sofía Marquez",
    location: "Alagón del Rio",
    text: "Excelente calidad y trato cercano. Manuel me aconsejó qué variedad elegir y acertó de pleno. Muy agradecida por el servicio.",
    rating: 5
  },
  {
    name: "Elena Tello",
    location: "Villanueva de la Sierra",
    text: "Compré el pack de regalo para mis padres y quedaron encantados. La presentación es muy cuidada y la miel exquisita. ¡Muy recomendada!",
    rating: 5
  }
];
---

<section id="testimonios" class="py-24 bg-white relative overflow-hidden">

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-4xl md:text-5xl font-display font-medium text-stone-900">
        Lo que dicen nuestros clientes
      </h2>
      <p class="text-stone-600 max-w-2xl mx-auto text-lg">
        La confianza de quienes ya disfrutan de nuestra miel de Las Hurdes y Sierra de Gata es nuestro mejor aval.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-stone-50 p-8 rounded-2xl border border-stone-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative group">
          <Quote class="w-10 h-10 text-brand-300 absolute top-6 right-6 opacity-50 group-hover:opacity-100 transition-opacity" />
          
          <div class="flex gap-1 mb-6">
            {[...Array(t.rating)].map(() => (
              <Star class="w-5 h-5 text-brand-300 fill-brand-300" />
            ))}
          </div>

          <p class="text-stone-700 leading-relaxed mb-6 italic min-h-[80px]">
            "{t.text}"
          </p>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-brand-300 flex items-center justify-center text-stone-900 font-bold text-lg font-display">
              {t.name.charAt(0)}
            </div>
            <div>
              <h4 class="font-bold text-stone-900">{t.name}</h4>
              <p class="text-xs text-stone-500 uppercase tracking-wider">{t.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
