---
export const prerender = true;
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AddToCartButton from '../../components/AddToCartButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import { shipping, site } from '../../data/site';
import { breadcrumbJsonLd, productJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = products.filter((item) => item.id !== product.id);
const shippingCost = shipping.cost.toFixed(2).replace('.', ',');
const url = `/productos/${product.id}`;

const jsonLd = [
  productJsonLd(product),
  breadcrumbJsonLd([
    { name: 'Inicio', path: '/' },
    { name: 'Productos', path: '/productos' },
    { name: product.title, path: url },
  ]),
];
---

<Layout
  title={`${product.title} · Miel cruda de Las Hurdes | ${site.name}`}
  description={product.description}
  ogImage={`/og/${product.id}.jpg`}
  type="product"
  jsonLd={jsonLd}
>
  <Header solid />
  <main class="pt-28 pb-20 bg-gradient-to-b from-white via-brand-50/30 to-white">
    <div class="container mx-auto px-6">
      <nav aria-label="Migas de pan" class="text-sm text-stone-500 mb-8">
        <a href="/" class="hover:text-brand-600">Inicio</a>
        <span class="mx-2 text-stone-300">/</span>
        <a href="/productos" class="hover:text-brand-600">Productos</a>
        <span class="mx-2 text-stone-300">/</span>
        <span class="text-stone-700">{product.title}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Imagen -->
        <div class="bg-gradient-to-b from-stone-50 to-white rounded-3xl border border-stone-100 p-8 md:p-12 flex items-center justify-center">
          <Image
            src={product.image}
            alt={`${product.title} - miel de bosque cruda de Las Hurdes y Sierra de Gata`}
            class="w-full max-w-sm h-auto object-contain drop-shadow-xl"
            widths={[400, 700]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Ficha -->
        <div>
          <p class="text-brand-600 font-semibold tracking-widest uppercase text-xs mb-3">
            Miel cruda · Origen Extremadura
          </p>
          <h1 class="text-4xl md:text-5xl font-display font-medium text-stone-900 mb-4">
            {product.title}
          </h1>

          <div class="flex items-baseline gap-3 mb-6">
            <span class="text-3xl font-bold text-brand-600 font-display">{product.price.toFixed(2)}€</span>
            <span class="text-sm text-stone-400">IVA incluido · {product.weight}</span>
          </div>

          <p class="text-lg text-stone-600 leading-relaxed mb-8">{product.description}</p>

          <div class="mb-8">
            <AddToCartButton
              id={product.id}
              name={product.title}
              price={product.price}
              image={product.image}
              class="py-4 text-base"
            />
          </div>

          <ul class="space-y-3 mb-8">
            {product.features.map((feature) => (
              <li class="flex items-start gap-3 text-stone-600">
                <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <dl class="grid grid-cols-2 gap-4 text-sm border-t border-stone-200 pt-6">
            <div>
              <dt class="text-stone-500">Formato</dt>
              <dd class="font-medium text-stone-800">{product.weight}</dd>
            </div>
            <div>
              <dt class="text-stone-500">Origen</dt>
              <dd class="font-medium text-stone-800">Sierra de Gata y Las Hurdes</dd>
            </div>
            <div>
              <dt class="text-stone-500">Envío</dt>
              <dd class="font-medium text-stone-800">{shippingCost} € · gratis desde {shipping.threshold} €</dd>
            </div>
            <div>
              <dt class="text-stone-500">Referencia</dt>
              <dd class="font-medium text-stone-800">{product.sku}</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Descripción larga -->
      <div class="max-w-3xl mt-16 space-y-5 text-stone-600 leading-relaxed">
        <h2 class="text-2xl font-display font-medium text-stone-900 mb-2">Sobre esta miel</h2>
        {product.longDescription.map((paragraph) => <p>{paragraph}</p>)}
        <p>
          ¿Quieres saber cómo distinguir una miel cruda de una industrial? Lo explicamos en
          <a href="/blog/miel-cruda" class="text-brand-700 underline hover:text-brand-800">esta guía sobre la miel cruda</a>
          y en <a href="/blog/miel-de-las-hurdes" class="text-brand-700 underline hover:text-brand-800">el artículo sobre la miel de Las Hurdes</a>.
        </p>
      </div>

      <!-- Productos relacionados -->
      <div class="mt-20">
        <h2 class="text-3xl font-display font-medium text-stone-900 mb-8">Otros formatos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl">
          {related.map((item) => (
            <ProductCard
              id={item.id}
              href={`/productos/${item.id}`}
              name={item.title}
              price={item.price}
              description={item.description}
              image={item.image}
              badge={item.badge}
              weight={item.weight}
            />
          ))}
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>