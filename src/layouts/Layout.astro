---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Cart from '../components/Cart.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Miel HurdeGatina - Miel artesanal de Las Hurdes. Tradición y sabor natural." } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content="#fbbf24" />
		<title>{title}</title>

        <!-- Open Graph / Facebook -->
        <meta property="og:locale" content="es_ES" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL('/logo-rgb-A85MJZK7J2SBMK2k.avif', Astro.site)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Miel HurdeGatina" />
        <meta property="og:site_name" content="Miel HurdeGatina" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL('/logo-rgb-A85MJZK7J2SBMK2k.avif', Astro.site)} />
		
		


		<script type="application/ld+json">
			{
			  "@context": "https://schema.org",
			  "@type": "LocalBusiness",
			  "name": "Miel HurdeGatina",
			  "description": "Miel pura de abeja cosechada artesanalmente en Las Hurdes y Sierra de Gata. 100% natural.",
			  "address": {
				"@type": "PostalAddress",
				"streetAddress": "Torrecilla de los Ángeles",
				"addressLocality": "Torrecilla de los Ángeles",
				"addressRegion": "Cáceres",
				"postalCode": "10869",
				"addressCountry": "ES"
			  },
			  "geo": {
					"@type": "GeoCoordinates",
					"latitude": 40.2478918,
					"longitude": -6.4163881
				  },
			  "url": "https://mielhurdegatina.com",
			  "telephone": "+34659393507",
			  "priceRange": "€",
			  "areaServed": ["Sierra de Gata", "Las Hurdes", "Extremadura"]
			}
		</script>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
		
		<Analytics />
		<SpeedInsights />
	</head>
	<body class="min-h-screen flex flex-col">
		<slot />
		<Cart />
		<WhatsAppButton />
		<CookieBanner />
		
	</body>
</html>
