{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/capture-paypal-order/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/confirm-order/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/create-order/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/create-payment-intent/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/create-paypal-order/?$",
			"dest": "_render"
		},
		{
			"src": "^/checkout/?$",
			"dest": "_render"
		},
		{
			"src": "^/exito/?$",
			"dest": "_render"
		},
		{
			"src": "^/pedido-confirmado/?$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt/?$",
			"dest": "_render"
		}
	]
}